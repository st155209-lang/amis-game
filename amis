    btn.className = "choiceBtn";
    btn.textContent = opt;
    if (showKeys && KEY_MAPS[team.idx]) {
      const hint = document.createElement("span");
      hint.className = "keyHint";
      hint.textContent = KEY_MAPS[team.idx][optIdx].toUpperCase();
      btn.appendChild(hint);
    }
    btn.onclick = () => handleAnswer(team, opt, btn);
    choicesEl.appendChild(btn);
  });
  document.getElementById("f-" + team.idx).textContent = "";
}

function handleAnswer(team, selected, btnEl) {
  if (team.eliminated || matchOver) return;
  const feedbackEl = team.isAI ? null : document.getElementById("f-" + team.idx);
  if (!team.isAI) document.querySelectorAll("#c-" + team.idx + " .choiceBtn").forEach(b => b.disabled = true);

  const correct = selected === team.current.answer;
  if (correct) {
    if (btnEl) btnEl.classList.add("correct");
    team.correctCount++; team.streak++;
    const chance = Math.min(0.85, bonusChance(team.correctCount));
    const now = gameNow();
    const reactionMs = Date.now() - (team.questionShownAt || Date.now());
    const isFastReaction = reactionMs <= 3000;
    let msg = "✅ 答對！";

    // 答對直接貢獻一點虛擬擊殺經驗，讓技能升級不完全依賴戰場上是否真的殺得到敵人
    creditKill(team.idx, 1);

    // 連續答對每逢3的倍數（3、6、9、12...）：觸發「水晶極速」，我方兵移動速度暫時+40%
    if (team.streak % 3 === 0) {
      team.streakSpeedUntil = now + STREAK_SPEED_DURATION;
      showMilestoneBanner(team, "水晶之神給予我們「水晶極速」，一鼓作氣衝進去！");
    }

    if (team.streak % 4 === 0 && tierCountOf(team.idx, 3) < TIER3_CAP && now >= team.tier3CooldownUntil) {
      spawnUnit(team.idx, 3, false); team.tier3CooldownUntil = now + TIER3_COOLDOWN_MS; msg += "💠祝福兵！";
    } else if (team.streak % 2 === 0 && tierCountOf(team.idx, 2) < TIER2_CAP) {
      spawnUnit(team.idx, 2, false); msg += "⚡感謝兵！";
    } else if (isFastReaction && troopCountOf(team.idx) < TROOP_CAP) {
      spawnUnit(team.idx, 1, false); msg += "⚡神速反應！援兵來了！";
      showMilestoneBanner(team, "援兵來了！衝啊！");
    } else if (Math.random() < chance && troopCountOf(team.idx) < TROOP_CAP) {
      spawnUnit(team.idx, 1, false); msg += "疊加迎賓兵";
    } else {
      msg += "(累積" + team.correctCount + "題)";
    }
    if (feedbackEl) feedbackEl.textContent = msg;
  } else {
    if (btnEl) btnEl.classList.add("wrong");
    team.streak = 0;
    if (feedbackEl) feedbackEl.textContent = "❌ 正解：" + team.current.answer;
  }

  setTimeout(() => {
    if (!team.isAI) document.querySelectorAll("#c-" + team.idx + " .choiceBtn").forEach(b => b.disabled = false);
    nextQuestion(team);
  }, team.isAI ? 0 : 1000);
}

function aiLoop() {
  if (matchOver) return;
  const aiTeam = teams.find(t => t.isAI && !t.eliminated);
  if (!aiTeam || !aiTeam.current) return;
  const correct = Math.random() < 0.55;
  const options = aiTeam.current.options;
  const selected = correct ? aiTeam.current.answer : options.find(o => o !== aiTeam.current.answer);
  handleAnswer(aiTeam, selected, null);
}

/* ---------- 鍵盤分區作答（僅大螢幕模式） ---------- */
document.addEventListener("keydown", (e) => {
  if (displayMode !== "screen") return;
  if (!document.getElementById("screen-battle").classList.contains("active")) return;
  if (matchOver) return;
  const key = e.key.toLowerCase();
  teams.forEach(t => {
    if (t.isAI || t.eliminated || !t.current) return;
    const keys = KEY_MAPS[t.idx];
    if (!keys) return;
    const optIdx = keys.indexOf(key);
    if (optIdx >= 0 && t.current.options[optIdx] !== undefined) {
      const btn = document.querySelectorAll("#c-" + t.idx + " .choiceBtn")[optIdx];
      if (btn && !btn.disabled) handleAnswer(t, t.current.options[optIdx], btn);
    }
  });
});

/* ---------- 兵種與隊形 ---------- */

/* ============ 小兵美術素材（三個階級共用，跨隊伍以顏色圈識別） ============ */
const TIER_SPRITES = {
  1: {
    static: "data:image/png;base64,",
    walk: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"],
    skill: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"]
  },
  2: {
    static: "data:image/png;base64,",
    walk: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"],
    skill: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"]
  },
  3: {
    static: "data:image/png;base64,",
    walk: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"],
    skill: ["data:image/png;base64,", "data:image/png;base64,", "data:image/png;base64,"]
  },
};

const TIER_STATS = {
  1: { hp: 15, atk: 2.2, range: 22, speed: 1.0, badge: "" },
  2: { hp: 10, atk: 4.5, range: 34, speed: 1.15, badge: "⚡" },
  3: { hp: 20, atk: 0,   range: 0,  speed: 0.6,  badge: "💠" },
};
/* 攻城傷害：只影響兵抵達敵方基地時造成的傷害，不影響兵種之間互打的一般戰鬥數值 */
const BASE_DAMAGE_BY_TIER = { 1: 4, 2: 7, 3: 0 };
const BREAKTHROUGH_RATIO = 3; // 我方兵力達對方迎擊兵力此倍數以上，多出的兵直接無視交戰衝向基地
const BREAKTHROUGH_MAX_PER_LANE = 6; // 每次最多同時幾隻兵能判定突破，避免兵力優勢時全軍暴衝瞬間爆量傷害

function troopCountOf(teamIdx) { return units.filter(u => u.team === teamIdx && u.hp > 0).length; }
function tierCountOf(teamIdx, tier) { return units.filter(u => u.team === teamIdx && u.tier === tier && u.hp > 0).length; }
function laneTroopCountOf(teamIdx, laneTarget) { return units.filter(u => u.team === teamIdx && u.laneTarget === laneTarget && u.hp > 0).length; }

/* 選擇這隻兵要走哪一條進攻路線（雙線分流）：挑目前該路線兵力較少的敵方，維持兩線平衡 */
function pickLaneTarget(teamIdx) {
  const others = teams.map((t, i) => i).filter(i => i !== teamIdx && !teams[i].eliminated);
  if (others.length === 0) return null;
  if (others.length === 1) return others[0];
  let best = others[0], bestCount = laneTroopCountOf(teamIdx, others[0]);
  for (let i = 1; i < others.length; i++) {
    const c = laneTroopCountOf(teamIdx, others[i]);
    if (c < bestCount) { best = others[i]; bestCount = c; }
  }
  return best;
}

function spawnUnit(teamIdx, tier, isBaseline) {
  const team = teams[teamIdx];
  if (team.eliminated) return;
  if (tier === 1 && troopCountOf(teamIdx) >= TROOP_CAP) return;

  const laneTarget = pickLaneTarget(teamIdx);
  const laneBase = laneTarget !== null ? teams[laneTarget] : null;

  const battlefield = document.getElementById("battlefield");
  const stats = TIER_STATS[tier];

  // 隊形方向改成朝向「這隻兵被分配到的那條路線敵方基地」，而不是朝向戰場整體中心，
  // 這樣同一方會自然分成兩條進攻隊伍，各自對準不同敵人，不會全部擠向同一個點
  const targetX = laneBase ? laneBase.baseX : team.centerX;
  const targetY = laneBase ? laneBase.baseY : team.centerY;
  const dx = targetX - team.baseX, dy = targetY - team.baseY;
  const dist = Math.hypot(dx, dy) || 1;
  const dirX = dx / dist, dirY = dy / dist;
  const perpX = -dirY, perpY = dirX;

  const laneRank = laneTarget !== null ? laneTroopCountOf(teamIdx, laneTarget) : troopCountOf(teamIdx);
  const formationRank = laneRank % BASELINE_WAVE_SIZE; // 每8波重新從中心開始排雁行，避免隊形無限往外擴散
  const side = formationRank % 2 === 0 ? -1 : 1;
  const depth = Math.ceil(formationRank / 2);
  const rowSpacing = 12, pullBack = 9, edgeOffset = 24;

  let x = team.baseX + dirX * edgeOffset + perpX * side * depth * rowSpacing - dirX * depth * pullBack;
  let y = team.baseY + dirY * edgeOffset + perpY * side * depth * rowSpacing - dirY * depth * pullBack;
  x = Math.max(8, Math.min(fieldW - 8, x));
  y = Math.max(8, Math.min(fieldH - 8, y));

  const el = document.createElement("div");
  el.className = "unit bg spawnFlash";
  el.style.background = team.color;
  el.style.color = team.color;
  el.style.left = pctX(x) + "%"; el.style.top = pctY(y) + "%";
  const sprite = TIER_SPRITES[tier];
  let img = null;
  if (sprite) {
    const foot = document.createElement("div");
    foot.className = "footShadow";
    foot.style.background = team.color;
    el.appendChild(foot);
    img = document.createElement("img");
    img.className = "troopSprite";
    img.src = sprite.static;
    el.appendChild(img);
  } else {
    el.textContent = team.icon;
  }
  if (stats.badge) {
    const b = document.createElement("span");
    b.className = "badge"; b.textContent = stats.badge;
    el.appendChild(b);
  }
  const hpWrap = document.createElement("div");
  hpWrap.className = "hpbar";
  const hpFill = document.createElement("div");
  hpFill.className = "hpfill";
  hpWrap.appendChild(hpFill);
  el.appendChild(hpWrap);

  if (tier === 3) {
    const aura = document.createElement("div");
    aura.className = "auraPulse";
    aura.style.background = "radial-gradient(circle, " + team.color + "55 0%, transparent 70%)";
    el.appendChild(aura);
  }

  battlefield.appendChild(el);

  units.push({
    el, hpFillEl: hpFill, x, y, hp: stats.hp, maxHp: stats.hp,
    team: teamIdx, tier, atk: stats.atk, range: stats.range, speed: stats.speed, isFg: false,
    laneTarget, spawnSeq: spawnSeqCounter++,
    spriteImgEl: img, spriteData: sprite, animPhase: 0, animTickCounter: 0, animState: "walk"
  });
}

const BASELINE_WAVE_SIZE = 8; // 每波基礎補兵數量
function baselineSpawn() {
  if (matchOver) return;
  teams.forEach(t => {
    if (t.eliminated) return;
    for (let i = 0; i < BASELINE_WAVE_SIZE; i++) spawnUnit(t.idx, 1, true);
  });
}

/* ---------- 戰鬥迴圈 ---------- */
function distance(a, b) { return Math.hypot(a.x - b.x, a.y - b.y); }

function findNearestEnemyUnit(unit) {
  let best = null, bestD = Infinity;
  for (const u of units) {
    if (u.team === unit.team || u.hp <= 0) continue;
    const d = distance(unit, u);
    if (d < bestD) { bestD = d; best = u; }
  }
  return best;
}
function findNearestEnemyBase(unit) {
  let best = null, bestD = Infinity;
  teams.forEach(t => {
    if (t.idx === unit.team || t.eliminated) return;
    const d = Math.hypot(t.baseX - unit.x, t.baseY - unit.y);
    if (d < bestD) { bestD = d; best = t; }
  });
  return best;
}

/* 決定單位要用前景細節規格還是背景量體規格呈現 */
function updateForegroundState(unit, nearestEnemy) {
  const lowHp = unit.hp / unit.maxHp < FG_LOWHP_RATIO;
  const inCombat = nearestEnemy && distance(unit, nearestEnemy) < FG_DISTANCE_THRESHOLD;
  const shouldFg = unit.tier >= 2 || lowHp || inCombat;
  if (shouldFg !== unit.isFg) {
    unit.isFg = shouldFg;
    unit.el.classList.toggle("fg", shouldFg);
    unit.el.classList.toggle("bg", !shouldFg);
  }
  unit.el.classList.toggle("lowhp", lowHp && shouldFg);
  if (lowHp && shouldFg && !unit.el.querySelector(".lowHpRing")) {
    const ring = document.createElement("div");
    ring.className = "lowHpRing";
    unit.el.appendChild(ring);
  }
}

const ANIM_FRAME_INTERVAL_TICKS = 6; // 每6格(約240ms)才切換一次動畫幀，節省效能
function updateUnitAnim(unit, state) {
  if (!unit.isFg || !unit.spriteData || !unit.spriteImgEl) return;
  if (unit.animState !== state) { unit.animState = state; unit.animPhase = 0; unit.animTickCounter = 0; }
  unit.animTickCounter++;
  if (unit.animTickCounter < ANIM_FRAME_INTERVAL_TICKS) return;
  unit.animTickCounter = 0;
  const frames = state === "skill" ? unit.spriteData.skill : unit.spriteData.walk;
  unit.animPhase = (unit.animPhase + 1) % frames.length;
  unit.spriteImgEl.src = frames[unit.animPhase];
}

function gameTick() {
  if (matchOver) return;
  gameElapsedMs += TICK_MS * gameSpeed;
  const now = gameNow();

  // 祝福兵治療光環
  units.forEach(u => {
    if (u.tier === 3 && u.hp > 0) {
      units.forEach(o => {
        if (o.team === u.team && o !== u && o.hp > 0 && distance(u, o) < 60) {
          o.hp = Math.min(o.maxHp, o.hp + 0.12 * gameSpeed);
          if (o.isFg) o.hpFillEl.style.width = (o.hp / o.maxHp) * 100 + "%";
        }
      });
    }
  });

  // 兵力優勢突破：依「路線」比較敵我兵力，我方兵力壓倒對方迎擊兵力達倍數門檻時，
  // 超出對方迎擊人數的那部分我方兵力直接無視交戰，衝向敵方基地（模擬防線被突破的破口）
  const breakthroughSet = new Set();
  const laneGroups = {};
  units.forEach(u => {
    if (u.hp <= 0 || u.tier === 3 || u.laneTarget === null || u.laneTarget === undefined) return;
    const key = u.team + "-" + u.laneTarget;
    (laneGroups[key] = laneGroups[key] || []).push(u);
  });
  Object.keys(laneGroups).forEach(key => {
    const parts = key.split("-");
    const teamIdx = Number(parts[0]), laneIdx = Number(parts[1]);
    const myUnits = laneGroups[key];
    const enemyOpposing = units.filter(u => u.team === laneIdx && u.laneTarget === teamIdx && u.hp > 0).length;
    if (enemyOpposing === 0) {
      myUnits.sort((a, b) => a.spawnSeq - b.spawnSeq);
      myUnits.slice(0, BREAKTHROUGH_MAX_PER_LANE).forEach(u => breakthroughSet.add(u)); // 無人防守也設上限，避免一次全軍暴衝秒殺基地
    } else if (myUnits.length >= enemyOpposing * BREAKTHROUGH_RATIO) {
      myUnits.sort((a, b) => a.spawnSeq - b.spawnSeq);
      myUnits.slice(enemyOpposing, enemyOpposing + BREAKTHROUGH_MAX_PER_LANE).forEach(u => breakthroughSet.add(u)); // 前段維持正常交戰，超出的部分限量突破
    }
  });

  units.forEach(unit => {
    if (unit.hp <= 0 || unit.tier === 3) return;
    if (unit.stunnedUntil && now < unit.stunnedUntil) return; // 暈眩中，跳過移動與攻擊

    const ownerTeam = teams[unit.team];
    const speedMult = (ownerTeam && now < ownerTeam.speedBuffUntil) ? (ownerTeam.character.multiplier || 1) : 1;
    const streakSpeedMult = (ownerTeam && now < ownerTeam.streakSpeedUntil) ? STREAK_SPEED_BONUS : 1;
    const atkMult = (ownerTeam && now < ownerTeam.atkBuffUntil) ? (ownerTeam.atkBuffMultiplier || 1) : 1;
    const effSpeed = unit.speed * speedMult * streakSpeedMult * gameSpeed;
    const effAtk = unit.atk * atkMult * gameSpeed;
    const isBreakthrough = breakthroughSet.has(unit);
    unit.el.classList.toggle("rush", isBreakthrough);

    const target0 = isBreakthrough ? null : findNearestEnemyUnit(unit);
    const target = (!isBreakthrough && target0 && distance(unit, target0) <= ENGAGEMENT_RADIUS) ? target0 : null;
    updateForegroundState(unit, target);

    if (target && distance(unit, target) <= unit.range + 18) {
      target.hp -= effAtk * (TICK_MS / 1000);
      if (target.hp < 0) target.hp = 0;
      if (target.isFg) target.hpFillEl.style.width = Math.max(0, (target.hp / target.maxHp) * 100) + "%";
      if (target.hp <= 0) {
        target.el.remove();
        creditKill(unit.team);
      }
      updateUnitAnim(unit, "skill");
    } else {
      let tx, ty;
      if (target) { tx = target.x; ty = target.y; }
      else {
        // 沒有交戰目標時，朝出生時分配到的路線敵方基地前進；若該敵方已淘汰，改找場上最近的敵方基地
        let laneTeam = (unit.laneTarget !== null && teams[unit.laneTarget] && !teams[unit.laneTarget].eliminated) ? teams[unit.laneTarget] : null;
        const enemyBase = laneTeam || findNearestEnemyBase(unit);
        if (!enemyBase) return;
        tx = enemyBase.baseX; ty = enemyBase.baseY;
      }
      const ddx = tx - unit.x, ddy = ty - unit.y;
      const d = Math.hypot(ddx, ddy) || 1;
      unit.x += (ddx / d) * effSpeed;
      unit.y += (ddy / d) * effSpeed;
      unit.el.style.left = pctX(unit.x) + "%";
      unit.el.style.top = pctY(unit.y) + "%";
      unit.el.classList.toggle("flip", ddx < 0);
      updateUnitAnim(unit, "walk");

      teams.forEach(t => {
        if (t.idx === unit.team || t.eliminated) return;
        if (Math.hypot(t.baseX - unit.x, t.baseY - unit.y) < 22) {
          const shielded = t.baseShieldUntil && now < t.baseShieldUntil;
          if (!shielded) t.hp = Math.max(0, t.hp - (BASE_DAMAGE_BY_TIER[unit.tier] || 1));
          unit.hp = 0; unit.el.remove();
        }
      });
    }
  });

  units = units.filter(u => u.hp > 0);
  checkEliminations();
  updateTopbar();
  updateMatchTimer(now);
  teams.forEach(t => { if (!t.isAI) updateSkillButton(t); });
  checkTimeLimit(now);
  checkWinCondition();
}

function updateMatchTimer(now) {
  const el = document.getElementById("matchTimer");
  if (!el) return;
  const elapsed = now - matchStartTime;
  const remain = Math.max(0, MATCH_HARD_CAP_MS - elapsed);
  const mm = String(Math.floor(remain / 60000)).padStart(2, "0");
  const ss = String(Math.floor((remain % 60000) / 1000)).padStart(2, "0");
  el.textContent = "⏱️ 剩餘 " + mm + ":" + ss + (gameSpeed > 1 ? " ｜ " + gameSpeed + "x 加速中" : "");
}

/* 擊殺計數與技能等級判定；amount預設1，答對題目貢獻經驗值時也共用同一個計數 */
function creditKill(teamIdx, amount) {
  const team = teams[teamIdx];
  if (!team) return;
  team.kills += (amount || 1);
  const newLevel = team.kills >= LV3_KILLS ? 3 : (team.kills >= LV2_KILLS ? 2 : 1);
  if (newLevel !== team.skillLevel) team.skillLevel = newLevel;
}

/* 主動技能施放 */
function activateSkill(team) {
  if (!team || team.eliminated || matchOver || !team.character || team.skillLevel < 2) return;
  const now = gameNow();
  if (now < team.skillCooldownUntil) return;
  const skill = team.character;

  if (skill.type === "buff_speed_atk") {
    team.speedBuffUntil = now + skill.duration;
    team.atkBuffUntil = now + skill.duration;
    team.atkBuffMultiplier = skill.multiplier;
  } else if (skill.type === "buff_atk") {
    team.atkBuffUntil = now + skill.duration;
    team.atkBuffMultiplier = skill.multiplier;
  } else if (skill.type === "shield") {
    team.baseShieldUntil = now + skill.duration;
  } else if (skill.type === "stun") {
    const ours = units.filter(u => u.team === team.idx && u.hp > 0);
    const enemyUnits = units.filter(u => u.team !== team.idx && u.hp > 0);
    enemyUnits.forEach(u => { u._d = ours.length ? Math.min(...ours.map(o => distance(o, u))) : Infinity; });
    enemyUnits.sort((a, b) => a._d - b._d);
    enemyUnits.slice(0, skill.targets || 3).forEach(u => { u.stunnedUntil = now + skill.duration; });
  } else if (skill.type === "execute") {
    const enemyUnits = units.filter(u => u.team !== team.idx && u.hp > 0 && u.tier !== 3);
    if (enemyUnits.length) {
      enemyUnits.sort((a, b) => a.hp - b.hp);
      const victim = enemyUnits[0];
      victim.hp = 0;
      victim.el.remove();
      creditKill(team.idx);
    }
  }
  team.skillCooldownUntil = now + SKILL_COOLDOWN_BY_LEVEL[team.skillLevel];
  showSkillBanner(team, skill);
  updateSkillButton(team);
}

document.addEventListener("keydown", (e) => {
  if (displayMode !== "screen" || matchOver) return;
  if (!document.getElementById("screen-battle").classList.contains("active")) return;
  const key = e.key.toLowerCase();
  teams.forEach(t => {
    if (t.isAI) return;
    if (SKILL_KEYS[t.idx] === key) activateSkill(t);
  });
});

/* 賽程時間上限：超過MATCH_HARD_CAP_MS強制比血量決勝負 */
function checkTimeLimit(now) {
  if (matchOver) return;
  if (now - matchStartTime >= MATCH_HARD_CAP_MS) {
    matchOver = true;
    battleTimers.forEach(tm => clearInterval(tm));
    const alive = teams.filter(t => !t.eliminated);
    let winner = null, maxHp = -1, tie = false;
    alive.forEach(t => {
      if (t.hp > maxHp) { maxHp = t.hp; winner = t; tie = false; }
      else if (t.hp === maxHp) { tie = true; }
    });
    const banner = document.getElementById("resultBanner");
    banner.style.display = "block";
    banner.textContent = (winner && !tie) ? "⏱️ 時間到！血量最高獲勝：" + winner.name + "（" + winner.icon + "）" : "⏱️ 時間到！平手！";
    document.getElementById("restartBtn").style.display = "inline-block";
  }
}

function checkEliminations() {
  teams.forEach(t => {
    if (!t.eliminated && t.hp <= 0) {
      t.eliminated = true;
      units.filter(u => u.team === t.idx).forEach(u => u.el.remove());
      units = units.filter(u => u.team !== t.idx);
      const panel = document.getElementById("panel-" + t.idx);
      if (panel) panel.classList.add("eliminatedPanel");
    }
  });
}

function checkWinCondition() {
  const alive = teams.filter(t => !t.eliminated);
  if (alive.length <= 1 && !matchOver) {
    matchOver = true;
    battleTimers.forEach(tm => clearInterval(tm));
    const banner = document.getElementById("resultBanner");
    banner.style.display = "block";
    banner.textContent = alive.length === 1 ? "🎉 " + alive[0].name + "（" + alive[0].icon + "）獲勝！" : "⚔️ 平手！";
    document.getElementById("restartBtn").style.display = "inline-block";
  }
}

document.getElementById("restartBtn").onclick = () => showScreen("screen-language");
</script>
</body>
</html>
