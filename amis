  "魯凱語": AMIS_RUKAI_COURSES,
  "賽夏語": AMIS_SAISIYAT_COURSES,
  "太魯閣語": AMIS_TRUKU_COURSES,
};


function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }

function genRawQuestion(course) {
  let op = course.op === "mix" ? (Math.random() < 0.5 ? "add" : "sub") : course.op;
  let a, b, answer, qtext;
  if (op === "add") {
    a = randInt(1, course.max - 1);
    b = randInt(1, course.max - a);
    answer = a + b;
    qtext = a + " + " + b + " = ?";
  } else {
    a = randInt(1, course.max);
    b = randInt(0, a);
    answer = a - b;
    qtext = a + " - " + b + " = ?";
  }
  return { qtext, answer };
}

function buildQuestion(course) {
  const { qtext, answer } = genRawQuestion(course);
  const opts = new Set([answer]);
  let guard = 0;
  while (opts.size < 4 && guard < 40) {
    guard++;
    const cand = answer + randInt(-4, 4);
    if (cand < 0 || opts.has(cand)) continue;
    opts.add(cand);
  }
  return { q: qtext, options: [...opts].sort(() => Math.random() - 0.5), answer };
}

function generatePool(course, size) {
  if (course.type === "fixed") {
    // 真實題庫：直接使用給定的固定題目，不做程序生成，用shuffle-bag機制打亂順序即可
    return course.questions.map(q => ({ q: q.q, options: [...q.options], answer: q.answer }));
  }
  const pool = [], seen = new Set();
  let guard = 0;
  while (pool.length < size && guard < 800) {
    guard++;
    const cand = buildQuestion(course);
    if (seen.has(cand.q)) continue;
    seen.add(cand.q);
    pool.push(cand);
  }
  return pool;
}
function makeBag(pool) { return { pool, bag: [] }; }
function drawFromBag(bagObj) {
  if (bagObj.bag.length === 0) bagObj.bag = bagObj.pool.map((_, i) => i).sort(() => Math.random() - 0.5);
  return bagObj.pool[bagObj.bag.pop()];
}

