function computeBasePositions() {
  if (fieldShape === "rect") {
    teams[0].baseX = 20; teams[0].baseY = fieldH / 2;
    teams[1].baseX = fieldW - 20; teams[1].baseY = fieldH / 2;
  } else {
    teams[0].baseX = fieldW * 0.5;  teams[0].baseY = fieldH * 0.10;
    teams[1].baseX = fieldW * 0.08; teams[1].baseY = fieldH * 0.90;
    teams[2].baseX = fieldW * 0.92; teams[2].baseY = fieldH * 0.90;
  }
  const cx = teams.reduce((s, t) => s + t.baseX, 0) / teams.length;
  const cy = teams.reduce((s, t) => s + t.baseY, 0) / teams.length;
  teams.forEach(t => { t.centerX = cx; t.centerY = cy; });
}

