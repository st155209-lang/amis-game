  .quizPanel.eliminatedPanel { opacity: 0.35; }
  .quizTitle { font-size: clamp(10px,2.2vw,13px); margin-bottom: 4px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .quizPlayerTag { font-size: 0.8em; opacity: 0.6; font-weight: normal; }
  .question { font-size: clamp(13px,3vw,17px); margin-bottom: 6px; color: #ffd479; min-height: 30px; }
  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
  .choiceBtn { position: relative; padding: 7px 4px; font-size: clamp(11px,2.4vw,14px); background: #3a4a63; border: none; border-radius: 6px; color: white; cursor: pointer; }
  .choiceBtn:hover { background: #4a5f80; }
  .choiceBtn.correct { background: #3a8a3a !important; }
  .choiceBtn.wrong { background: #8a3a3a !important; }
  .keyHint { position: absolute; top: -6px; left: -6px; background: #ffd479; color: #222; font-size: 9px; font-weight: bold; border-radius: 4px; padding: 0 4px; }
  .feedback { margin-top: 5px; min-height: 15px; font-size: 10px; color: #9adf9a; }
  .skillBtn { width: 100%; margin-top: 6px; padding: 7px 4px; font-size: 11px; border-radius: 6px; border: none; cursor: pointer; background: #6a4a1e; color: #ffd479; }
