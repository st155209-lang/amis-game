<script>
/* ============================================================
   0. 顯示模式：自動偵測 + 手動切換
   ============================================================ */
function detectDisplayMode() { return window.innerWidth < 700 ? "phone" : "screen"; }
var displayMode = detectDisplayMode();
function refreshModeToggleLabel() {
  document.getElementById("modeToggle").textContent = displayMode === "phone" ? "📱 手機模式" : "🖥️ 大螢幕模式";
}
document.getElementById("modeToggle").onclick = () => {
  displayMode = displayMode === "phone" ? "screen" : "phone";
  refreshModeToggleLabel();
};
refreshModeToggleLabel();

/* 兵力上限對照表（依顯示模式 × 人數模式）－ 最終定案：實際同時在場兵力受生兵速度/戰鬥消耗/基地血量三者自然制衡，不需要為理論上限犧牲總量 */
const TROOP_CAP_TABLE = {
  phone:  { "1p": 50, "2p": 50, "3p": 45 },
  screen: { "1p": 100, "2p": 100, "3p": 90 },
};

/* 鍵盤分區（僅大螢幕模式啟用）：P1 / P2 / P3 各自對應一組按鍵 */
const KEY_MAPS = [["1","2","3","4"], ["q","w","e","r"], ["u","i","o","p"]];

/* ============================================================
   1. 題庫產生器（數學占位內容）
   ============================================================ */
const MATH_COURSES = [
  { id: "add10", label: "加法 10以內", emoji: "➕", max: 10, op: "add" },
  { id: "sub10", label: "減法 10以內", emoji: "➖", max: 10, op: "sub" },
  { id: "add20", label: "加法 20以內", emoji: "➕", max: 20, op: "add" },
  { id: "sub20", label: "減法 20以內", emoji: "➖", max: 20, op: "sub" },
  { id: "mix10", label: "加減混合 10以內", emoji: "🔀", max: 10, op: "mix" },
  { id: "mix20", label: "加減混合 20以內", emoji: "🔀", max: 20, op: "mix" },
