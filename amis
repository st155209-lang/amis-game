  .unit.flip { transform: translate(-50%,-50%) scaleX(-1); }

  .unit .badge { position: absolute; top: -7px; right: -7px; font-size: 9px; background:#1a1a1a; border-radius:50%; width:14px; height:14px; display:flex; align-items:center; justify-content:center; }
  .unit .hpbar { position: absolute; top: -8px; left: 0; width: 100%; height: 3px; background: #333; border-radius: 2px; overflow: hidden; }
