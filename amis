  @keyframes skillJump { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }

  #resultBanner { font-size: 18px; color: #ffd479; text-align: center; margin: 6px 0; display:none; flex-shrink:0; }
  #restartBtn { display:none; background:#ffd479; color:#222; border:none; padding:8px 18px; border-radius:8px; font-weight:bold; cursor:pointer; }
  #restartRow { text-align:center; flex-shrink:0; }

  .subTitle { display: block; font-size: 11px; color: #bbb; font-weight: 400; margin-top: 2px; letter-spacing: 2px; }
  .titleBanner { width: 100%; max-width: 900px; height: auto; border-radius: 14px; margin-bottom: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.5); }
    background-size: cover; background-position: center; border-radius: 12px;
    background-image: linear-gradient(rgba(10,12,20,0.55), rgba(10,12,20,0.55)), url('data:image/jpeg;base64,');
  }
  #battleHeader { text-align: center; font-size: 13px; color: #ffd479; letter-spacing: 3px; margin-bottom: 4px; flex-shrink: 0; text-shadow: 0 0 6px rgba(255,212,121,0.5); }
</style>
