  @keyframes spawnFlash { 0%{ opacity:0.2; } 100%{ opacity:1; } }
  .unit.rush { box-shadow: 0 0 0 2px #ffd479, 0 0 8px 2px rgba(255,212,121,0.7); }

  .auraPulse { position: absolute; width: 50px; height: 50px; border-radius: 50%; left:50%; top:50%; transform: translate(-50%,-50%); background: radial-gradient(circle, rgba(122,255,150,0.35) 0%, rgba(122,255,150,0) 70%); animation: auraPulseKF 2s ease-in-out infinite; pointer-events:none; }
  @keyframes auraPulseKF { 0%,100%{ transform: translate(-50%,-50%) scale(0.8); opacity:0.55;} 50%{ transform: translate(-50%,-50%) scale(1.25); opacity:1;} }

  #quizArea { display: flex; flex-wrap: nowrap; gap: 8px; width: 100%; margin-top: 8px; flex-shrink: 0; }
